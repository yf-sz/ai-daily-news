# 可选：Twitter/X API 凭据（用于收集 AI 大牛动态）
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# 可选：NewsAPI 密钥（https://newsapi.org）
NEWS_API_KEY=your_newsapi_key_here

# 可选：Semantic Scholar API 密钥（可提升请求限制）
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# 报告输出目录（默认：./reports）
OUTPUT_DIR=./reports

# 每个来源最多收集条目数（默认：10）
MAX_ITEMS_PER_SOURCE=10

# 收集过去几天的内容（默认：1，即今天）
DAYS_BACK=1
