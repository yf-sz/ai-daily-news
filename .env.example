# ── Claude API（自动收集模式必须设置）─────────────────────────────────
# 获取方式：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── 博客发布配置 ──────────────────────────────────────────────────────
# 博客仓库地址（GitHub Pages 仓库）
BLOG_REPO_URL=https://github.com/yf-sz/coco.github.io.git

# GitHub Personal Access Token（需要 contents:write 权限）
# 获取方式：GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# 权限：选择博客仓库，授予 Contents: Read and Write
BLOG_DEPLOY_TOKEN=your_github_pat_here

# 本地克隆博客仓库的目录（默认：/tmp/blog-repo）
# BLOG_REPO_DIR=/tmp/blog-repo

# ── 可选：第三方 API 密钥 ──────────────────────────────────────────────
# Twitter/X API 凭据（用于收集 AI 大牛动态）
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# NewsAPI 密钥（https://newsapi.org）
NEWS_API_KEY=your_newsapi_key_here

# Semantic Scholar API 密钥（可提升请求限制）
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# ── 收集参数 ───────────────────────────────────────────────────────────
# 报告输出目录（默认：./reports）
OUTPUT_DIR=./reports

# 每个来源最多收集条目数（默认：10）
MAX_ITEMS_PER_SOURCE=10

# 收集过去几天的内容（默认：1，即今天）
DAYS_BACK=1
